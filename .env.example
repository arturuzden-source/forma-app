# Пример конфигурации. Реальные значения задаются ТОЛЬКО в переменных Railway
# (Service → Variables). Этот файл без секретов и хранится в репозитории.

# Публичный адрес сервиса (выдаёт Railway)
PUBLIC_URL=https://example.up.railway.app

# Постоянное хранилище: путь, куда подключён Railway Volume
DATA_DIR=/data

# --- Секреты: вводит владелец в панели Railway ---
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# Telegram ID владельца (не секрет, но личные данные)
OWNER_TELEGRAM_ID=

# --- ИИ ---
AI_MODEL_CHAT=gpt-6-luna
AI_MODEL_PLAN=gpt-6.1-terra
AI_MODEL_VISION=gpt-6-luna
AI_MONTHLY_BUDGET_USD=5
AI_DAILY_TEXT_LIMIT=30
AI_DAILY_IMAGE_LIMIT=5
AI_EVAL_MODELS=gpt-6-luna,gpt-6.1-terra,gpt-6.1-sol
AI_EVAL_BUDGET_USD=0.5

# --- Резервные копии ---
BACKUP_RETENTION_DAYS=30
BACKUP_TIME_UTC=01:10

# Восстановление: имя папки копии (например 2026-10-27). Задать, перезапустить, затем удалить.
# RESTORE_FROM=
